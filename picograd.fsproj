<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>picograd</PackageId>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://github.com/drjoliv/picograd</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Library.fs" />
    <Compile Include="test/NodeTest.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="Expecto.FsCheck" Version="11.1.1" />
    <PackageReference Include="FSharp.Data" Version="8.2.0" />
  </ItemGroup>
</Project>
